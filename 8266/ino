#include <ESP8266WiFi.h>
#include <ESPAsyncTCP.h>
#include <ESPAsyncWebServer.h>
#include <FS.h>

// ===================== CONFIG =====================
const char* AP_SSID     = "BoardBuddy";
const char* AP_PASSWORD = "boardbuddy";

// If you later wire vibration / mmWave on 8266, set pins here:
const int PIN_VIBRATION = 4;   // D2 on many NodeMCU boards (adjust as needed)
// ==================================================

AsyncWebServer server(80);
AsyncEventSource events("/events");

float smoothRSSI = -90.0f;
unsigned long lastSample = 0;

// Dummy presence/vibration for now (UI expects these fields)
int   presenceCount     = 0;
float presenceDistance  = -1.0f;
bool  vibrationDetected = false;

// Get RSSI of first station connected to AP (ESP8266 way)
float getSmoothedRSSI() {
  struct station_info* stat = wifi_softap_get_station_info();
  float rssi;

  if (stat == nullptr) {
    rssi = -127; // no clients
  } else {
    // Take the first station's RSSI
    rssi = stat->rssi;
    wifi_softap_free_station_info();
  }

  // Exponential smoothing
  smoothRSSI = 0.8f * smoothRSSI + 0.2f * rssi;
  return smoothRSSI;
}

void setup() {
  Serial.begin(115200);
  delay(200);

  pinMode(PIN_VIBRATION, INPUT);

  // SPIFFS for UI
  if (!SPIFFS.begin()) {
    Serial.println("SPIFFS mount failed");
  }

  // AP mode
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASSWORD);
  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  // Serve UI from SPIFFS
  server.serveStatic("/", SPIFFS, "/").setDefaultFile("index.html");

  // SSE endpoint
  server.addHandler(&events);

  server.begin();
  Serial.println("Board Buddy ESP8266 started");
}

void loop() {
  unsigned long now = millis();
  if (now - lastSample < 500) return;  // sample every 500 ms
  lastSample = now;

  float rssi = getSmoothedRSSI();

  // If you wire a vibration sensor later, read it here:
  vibrationDetected = digitalRead(PIN_VIBRATION) == HIGH;

  // Build JSON payload (matches your app.js expectations)
  String json = "{";
  json += "\"rssi\":" + String(rssi, 1);
  json += ",\"presenceCount\":" + String(presenceCount);
  json += ",\"presenceDistance\":" + String(presenceDistance, 2);
  json += ",\"vibration\":" + String(vibrationDetected ? 1 : 0);
  json += "}";

  events.send(json.c_str(), "state", now);
}
